# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# FRED (Federal Reserve macro data: rates, inflation, labor, growth). Free key: https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=

# Optional: a custom OpenAI-compatible endpoint (vLLM, LM Studio, llama.cpp,
# relay). Select provider "openai_compatible" and set the base URL; the key is
# optional (local servers need none).
#OPENAI_COMPATIBLE_API_KEY=

# AWS Bedrock (provider "bedrock", install with: pip install ".[bedrock]").
# Auth: either a Bedrock API key (bearer token, no AWS access keys) OR the AWS
# credential chain (env keys / ~/.aws/credentials / IAM role / AWS_PROFILE). Set
# the region either way; a bearer token takes precedence when both are present.
#AWS_BEARER_TOKEN_BEDROCK=
#AWS_DEFAULT_REGION=us-west-2
#AWS_PROFILE=

# Optional: point at a remote Ollama server. When unset, defaults to
# the local instance at http://localhost:11434/v1. Convention follows
# the broader Ollama ecosystem; both the CLI dropdown and programmatic
# client pick this up.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Optional: override DEFAULT_CONFIG without editing code.
# Any TRADINGAGENTS_* variable below, when set, replaces the matching key
# in tradingagents/default_config.py. Values are coerced to the type of
# the existing default (bool / int / str), so "true"/"3" work as expected.
# In the CLI, setting the LLM provider / models / backend URL / language
# also skips the matching interactive selection step (useful for
# OpenAI-compatible endpoints like opencode or LM Studio, and unattended runs).
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_RESEARCH_DEPTH=1          # ONE depth knob: drives BOTH research and risk debate rounds to the same count
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1       # per-round override; wins over RESEARCH_DEPTH
#TRADINGAGENTS_MAX_RISK_ROUNDS=1         # per-round override; wins over RESEARCH_DEPTH
# Structured multi-agent debate (off by default; bit-identical when off).
#TRADINGAGENTS_ENABLE_DEBATE=false
#TRADINGAGENTS_DEBATE_BULL_MODEL=            # "family:id" for bull (research) AND aggressive (risk); fallback quick
#TRADINGAGENTS_DEBATE_BEAR_MODEL=            # "family:id" for bear (research) AND conservative (risk); z-ai/glm-5.3-flash was dropped (always truncated at the output cap); use deepseek-v4-flash
#TRADINGAGENTS_DEBATE_JUDGE_MODEL=           # "family:id" for the blind judge in BOTH sections; fallback deep
#TRADINGAGENTS_DEBATE_NEUTRAL_MODEL=         # "family:id" for the neutral RISK debater; fallback quick
#TRADINGAGENTS_DEBATE_JUDGE_ENSEMBLE=1
#TRADINGAGENTS_DEBATE_MAX_ROUNDS=5           # matches DebaterTurnPayload.round_index (1..5)
#TRADINGAGENTS_DEBATE_MIN_GAIN=0.05
#TRADINGAGENTS_DEBATE_STOP_CONSECUTIVE=2
#TRADINGAGENTS_DEBATE_CONSENSUS_THRESH=0.85
#TRADINGAGENTS_DEBATE_REGEN_MAX=1            # R1': single-role regeneration budget
#TRADINGAGENTS_DEBATE_DIVERGENCE_CAP_ROUNDS=1
#TRADINGAGENTS_DEBATE_REWEIGHT_TO_BASELINE=0.5
#TRADINGAGENTS_DEBATE_ENTRENCH_THRESH=0.8
#TRADINGAGENTS_DEBATE_DIVERGENCE_MIN=0.15
#TRADINGAGENTS_DEBATE_BASELINE_FALLBACK=true
#TRADINGAGENTS_DEBATE_REQUIRE_CAPABILITY_MATRIX=false
#TRADINGAGENTS_CHECKPOINT_ENABLED=false
# Sampling temperature (lower = less run-to-run variation on models that
# honor it). Unset leaves each provider at its default. See the README
# "Reproducibility" note — no setting makes LLM output fully deterministic.
#TRADINGAGENTS_TEMPERATURE=0.0
# LLM SDK retry budget forwarded to every provider. Unset leaves each SDK at its
# own default (usually 2). Raise it to ride out bursty 429 rate-limit throttling
# on rate-limited deployments (e.g. Azure OpenAI) instead of aborting the run.
#TRADINGAGENTS_LLM_MAX_RETRIES=6
# Provider-specific reasoning/thinking depth (optional; unset = provider
# default). Setting one also skips the matching interactive prompt.
#TRADINGAGENTS_OPENAI_REASONING_EFFORT=medium
#TRADINGAGENTS_GOOGLE_THINKING_LEVEL=high
#TRADINGAGENTS_ANTHROPIC_EFFORT=high

# ---------------------------------------------------------------------------
# Data vendors & API keys (optional; each vendor is skipped when unset)
# ---------------------------------------------------------------------------
#ALPHA_VANTAGE_API_KEY=
#FRED_API_KEY=
#TRADINGAGENTS_FINNHUB_API_KEY=
#TRADINGAGENTS_FMP_API_KEY=
#TRADINGAGENTS_EODHD_API_KEY=   # EODHD daily OHLCV (free 20/day; EOD plan $19.99/mo 100k/day)
# Massive.com U.S. market-data (news sentiment, economy, short interest,
# filings, snapshots). Free Basic tier: quotes only. Plan needed for stocks
# snapshots/fundamentals; delayed vs real-time per plan. US-centric.
#MASSIVE_API_KEY=
# or the config-key form (read first by dataflows.massive.massive_api_key):
#TRADINGAGENTS_MASSIVE_API_KEY=
# Tiingo market data (free Starter tier: ~500 daily calls/day, delayed
# quote snapshot + EOD/15m/1m EOD history, limited to 1y+ backfill).
#TIINGO_API_KEY=
# Twelve Data (free "Basic" tier: 800 credits/day, 8/min; US stocks/forex/crypto
# quotes + historical time-series OHLCV + technical indicators).
#TWELVEDATA_API_KEY=
# StockData.org (free "$0/mo": 100 requests/day; quote/EOD/intraday/news).
#STOCKDATA_API_KEY=
# NewsAPI.org (free Developer plan: 100 requests/day; global/macro headlines).
#NEWSAPI_API_KEY=
# Benzinga Basic Financial News API (free tier; register on AWS Marketplace for
# a token). Ticker-scoped financial news.
#BENZINGA_API_KEY=
# Massive Flat-File bulk OHLCV import (value-screener ATR/scan bases). OFF by
# default: bring up by putting a Massive day-aggregates CSV in massive_flat_dir
# then flipping the toggle on once your plan has Starter+ (snapshots/history).
#TRADINGAGENTS_ENABLE_MASSIVE_FLAT=false
# Massive Flat-File folder: drop the downloaded day-aggregates CSV(s) here.
#TRADINGAGENTS_MASSIVE_FLAT_DIR=data/massive_flat
# Alpaca market-data (analysis-only). Free IEX tier: daily history limited to
# the latest bar; keying is paper/b/data endpoints only — no trading in code.
#TRADINGAGENTS_ALPACA_API_KEY_ID=
#TRADINGAGENTS_ALPACA_API_SECRET=
# OpenBB Phase-3 free-tier data surfaces (keyless/free; analysis-only). Each is
# OFF by default - flip the matching flag to let its analyst @tool fetch real
# data. While off, the tool returns a clear DISABLED sentinel (never fabricates).
#TRADINGAGENTS_ENABLE_OPTIONS_SURFACE=false   # CBOE delayed options chain (strike/DTE/IV/greeks)
#TRADINGAGENTS_ENABLE_RISK_FREE_CURVE=false   # NY Fed SOFR + Treasury par yield curve (no key)
#TRADINGAGENTS_ENABLE_SCREENER=false          # yfinance universe screener (symbol/price/PE/EPS/beta/mkt-cap)
#TRADINGAGENTS_ENABLE_MARKET_MOVERS=false     # yfinance discovery: top gainers/losers/most-actives

# Moomoo OpenAPI gateway (OpenD). Credentials stay in OpenD (log in once with
# "remember password") - never put the moomoo password in .env.
#TRADINGAGENTS_MOOMOO_HOST=127.0.0.1
#TRADINGAGENTS_MOOMOO_PORT=11111
#TRADINGAGENTS_MOOMOO_ACCOUNT=
#TRADINGAGENTS_MOOMOO_AUTOSTART=false
#TRADINGAGENTS_MOOMOO_OPEND_PATH=
#TRADINGAGENTS_MOOMOO_MAX_CONNECTIONS=4
#TRADINGAGENTS_MOOMOO_CALL_TIMEOUT=5.0   # per-call wall-clock timeout (s) for moomoo SDK calls; the SDK's own wait allows 20s

# ---------------------------------------------------------------------------
# Strategy overlays (deterministic post-processing). Only enable_events /
# enable_reflection / enable_strategy_overlays / enable_sentiment are ON by
# default; the rest are opt-in (enable to use the layer). Set false to disable.
# ---------------------------------------------------------------------------
#TRADINGAGENTS_ENABLE_STRATEGY_OVERLAYS=true   # regime + vol-target size
#TRADINGAGENTS_ENABLE_ORDERFLOW=true
#TRADINGAGENTS_ENABLE_POSITION_CONTRACT=true   # G1 min(kelly, risk/stop)*vol*...
#TRADINGAGENTS_ENABLE_CALIBRATION=true
#TRADINGAGENTS_ENABLE_INDEPENDENT_VOTE=true   # Option-A: sample role stances BEFORE debate (no cross-talk); feeds agreement/consensus; debate stays the risk layer
#TRADINGAGENTS_ENABLE_COMPOSITE_RANK=true
#TRADINGAGENTS_ENABLE_EXITS=true
#TRADINGAGENTS_ENABLE_REPORT_ATTRIBUTION=true  # computed attribution + disclosure blocks in decision.md

# --- DSA polish (design_daily_stock_analysis_research.md §3.3/§3.5) ---
#TRADINGAGENTS_ENABLE_SKILL_OVERLAYS=true   # YAML strategy skills + regime-from-opinion (advisory folds)
#TRADINGAGENTS_SKILL_DIR=./data/skills     # custom skill dir (overrides builtin by name)
#TRADINGAGENTS_ENABLE_NEWS_RELEVANCE=true  # relevance scoring + official boost (advisory)

# --- DSA robustness (design_daily_stock_analysis_research.md §3.4/§3.6) ---
#TRADINGAGENTS_MARKET_SOURCE_PRIORITY={"US": "eodhd,tiingo,yfinance,moomoo"}  # opt-in per-market chains (default unchanged)
#TRADINGAGENTS_VENDOR_BREAKER_MAX_FAILURES=3
#TRADINGAGENTS_VENDOR_BREAKER_COOLDOWN_SECONDS=300

# --- DSA decision quality (design_daily_stock_analysis_research.md §3.1) ---
#TRADINGAGENTS_ENABLE_DECISION_GUARDRAIL=true   # post-PM downgrade-only stabilizer + confidence cap

# --- Qlib integration (design_qlib_integration.md) - advisory, default off ---
#TRADINGAGENTS_ENABLE_FACTOR_PROFILE=true      # Q1: get_factor_profile tool + alpha158 expression cache
#TRADINGAGENTS_ENABLE_TOPK_DROP=true           # Q3: screener alloc block uses Qlib Topk-Drop
#TRADINGAGENTS_ENABLE_ENHANCED_INDEX=true      # Q3: screener alloc block uses the convex enhanced-index
#TRADINGAGENTS_BACKTEST_LIMIT_THRESHOLD=0.0    # Q13: |day change| for limit-up/down gate (0=off)
#TRADINGAGENTS_BACKTEST_VOLUME_PARTICIPATION=0.0  # Q13: fill cap % of day volume (0=off; 0.2 rec.)
#TRADINGAGENTS_BACKTEST_DEAL_PRICE=close       # Q13: close|open|vwap or "buy,sell"
#TRADINGAGENTS_ENABLE_COMPUTED_CONTEXT=true
#TRADINGAGENTS_ENABLE_RISK_GOVERNOR=true       # PASS/WARN/REJECT + risk_halt
#TRADINGAGENTS_ENABLE_EVENTS=true              # B1 scheduled-catalyst overlay
#TRADINGAGENTS_ENABLE_DECISION_AUDIT=false     # PM report claim-vs-computed audit note
#TRADINGAGENTS_ENABLE_LIQUIDITY_GATE=false     # governor sizes vs ILLIQ/float-turnover/IWF verdict (risk2.md)
#TRADINGAGENTS_ENABLE_REFLECTION=true          # decision ledger hit-rates
#TRADINGAGENTS_ENABLE_SENTIMENT=true             # computed sentiment score + surprise velocity injected into the sentiment report
# Off by default: enable_regime / enable_factors / enable_threshold_gate (all
# have env overrides via TRADINGAGENTS_ENABLE_*).


# ---------------------------------------------------------------------------
# Institutional workflow (design_institutional_value_dip_workflow.md) - all
# advisory by default; hard-gate only when you flip a key.
# ---------------------------------------------------------------------------
#TRADINGAGENTS_VALUE_DIP_REQUIRE_CATALYST=false      # strict: re-rating evidence (surprise/revisions/accum/forward-PEG<1) required
#TRADINGAGENTS_VALUE_DIP_REGIME_GATE=false           # strict: block dip entries in high-vol / fast-downtrend / catalyst windows
#TRADINGAGENTS_VALUE_DIP_REGIME_VOL_CAP=0.8          # vol_pct above this blocks MR entries (when gate ON)
#TRADINGAGENTS_VALUE_DIP_REGIME_DOWNTREND_BAND=0.08  # price below 200-SMA by this -> knife guard (when gate ON)
#TRADINGAGENTS_VALUE_DIP_REGIME_HALVE=false          # instead of block, size x0.5
#TRADINGAGENTS_RISK_DAILY_LOSS_BUDGET_PCT=0.03       # daily realized-loss cap -> risk governor de-risks
#TRADINGAGENTS_RISK_HWM_SOFT_PCT=0.10                # drawdown-from-HWM soft tier (WARN)
#TRADINGAGENTS_RISK_HWM_HARD_PCT=0.20                # drawdown-from-HWM hard tier (REJECT new risk)
#TRADINGAGENTS_BREAKEVEN_TRIGGER=structure           # atr | r | structure (BE after confirmation)
#TRADINGAGENTS_STOP_NEVER_WIDEN=true                 # unified stop never widened
#TRADINGAGENTS_MIN_HOLDING_DAYS=5                    # turnover guard
#TRADINGAGENTS_MAX_TRADES_PER_PERIOD=4               # weekly churn cap
#TRADINGAGENTS_SLEEVE_TAG_ENABLED=true               # tag decisions with style sleeve (D1)
#TRADINGAGENTS_DRIFT_THRESHOLD=0.15                  # alpha-decay win-rate drift trigger (D2)
# --- Pre-open + execution-quality (Alpaca free IEX; advisory, never gates) ---
#TRADINGAGENTS_ENABLE_PREOPEN_RVOL=true              # P1: pre-market RVOL vs 30d pre-open avg
#TRADINGAGENTS_PREOPEN_RVOL_INSTITUTIONAL_X=2.0      # P1: RVOL threshold for 'institutional' read
#TRADINGAGENTS_ENABLE_PREOPEN_DEPTH=true             # P2: live IEX quote-depth (thin-book proxy)
#TRADINGAGENTS_ENABLE_ALPHA_PROFILE=true             # C3: post-fill drift vs arrival in report

# B1 catalyst overlay tuning
#TRADINGAGENTS_CATALYST_WINDOW_DAYS=7
#TRADINGAGENTS_CATALYST_BASELINE_MOVE=0.01
#TRADINGAGENTS_CATALYST_MACRO_WINDOW_DAYS=3
#TRADINGAGENTS_CATALYST_MACRO_SCALE=0.75
#TRADINGAGENTS_CATALYST_FED_WINDOW_DAYS=3
#TRADINGAGENTS_CATALYST_FED_SCALE=0.75
#TRADINGAGENTS_CATALYST_MISS_SCALE=0.8
#TRADINGAGENTS_CATALYST_SCALE_FLOOR=0.5
#TRADINGAGENTS_CATALYST_HARD_BLOCK_DAYS=0  # >0: REJECT new risk within N days of earnings

# Risk governor limits
#TRADINGAGENTS_RISK_MAX_DRAWDOWN_PCT=0.10
#TRADINGAGENTS_RISK_DAILY_CVAR_BUDGET_PCT=0.03
#TRADINGAGENTS_RISK_BASKET_TICKERS=SPY,QQQ   # R2 true portfolio CVaR: mix these names' daily returns
#TRADINGAGENTS_RISK_BASKET_WEIGHTS=SPY=0.5,QQQ=0.5  # optional weights; omitted = equal weight
#TRADINGAGENTS_HOLDINGS_TICKERS=SPY,QQQ      # Option B: actual-book tickers for the PM holdings read; empty = use the basket
#TRADINGAGENTS_HOLDINGS_WEIGHTS=SPY=0.5,QQQ=0.5  # actual-book weights; empty = use basket weights (cash remainder implicit)
#TRADINGAGENTS_RISK_COMPACT_REPORT=false

# ---------------------------------------------------------------------------
# Run / persistence
# ---------------------------------------------------------------------------
#TRADINGAGENTS_ANALYST_CONCURRENCY=1        # >1 runs analyst teams in threads
#TRADINGAGENTS_OPENROUTER_IGNORE_PROVIDERS=openinference,morph,relace,decart,ambient,inceptron,parasail,wafer,mancer,sail-research,phala,venice,io-net,akashml
#  ^ OpenRouter provider routing: comma-separated provider slugs to ALWAYS skip
#    (slow/unreliable endpoints). Sent as provider.ignore in the request body.
# Per-role max output tokens (most information, not overflowing; keeps tool calls healthy).
#TRADINGAGENTS_MAX_OUTPUT_TOKENS=8000          # fallback for both tiers
#TRADINGAGENTS_MAX_OUTPUT_TOKENS_QUICK=8000    # analysts / debaters / trader
#TRADINGAGENTS_MAX_OUTPUT_TOKENS_DEEP=2500     # Research Manager + Portfolio Manager
#TRADINGAGENTS_ENABLE_VALUE_DIP=false        # Value Dip + Swing hybrid --scan value-dip mode
#TRADINGAGENTS_ENABLE_TRANCHE_RISK=false     # tranche fold: governor sizes/throttles vs worst-case scale-in
#TRADINGAGENTS_TRANCHE_WEIGHTS=0.3,0.3,0.4   # 3-tranche weights (must sum to 1)
#TRADINGAGENTS_TRANCHE_STOP_MULT=1.5         # composite stop = P3 - k*ATR
#TRADINGAGENTS_TRANCHE_RISK_PCT=0.015        # worst-case capital-at-risk budget (fraction)
#TRADINGAGENTS_TRANCHE_ACCOUNT=100000        # account $ for tranche share sizing
#TRADINGAGENTS_ENABLE_PRE_MARKET_REVIEW=false # same-night catalyst/quality re-check in batch (choice a)
#TRADINGAGENTS_ENABLE_CORRELATION_PENALTY=false # allocation down-weights names highly correlated with the book
#TRADINGAGENTS_CORRELATION_THRESHOLD=0.6        # avg pairwise correlation above this triggers the penalty
#TRADINGAGENTS_CORRELATION_PENALTY_FRAC=0.3     # weight cut for a penalized name (renormalized across the book)
#TRADINGAGENTS_BENCHMARK_TICKER=SPY         # per-exchange alpha benchmark map
#TRADINGAGENTS_RESULTS_DIR=~/.tradingagents/logs
#TRADINGAGENTS_CACHE_DIR=~/.tradingagents/cache
#TRADINGAGENTS_MEMORY_LOG_PATH=~/.tradingagents/memory/trading_memory.md
#TRADINGAGENTS_CHECKPOINT_ENABLED=false  # per-ticker SQLite resume

# ---------------------------------------------------------------------------
# Optional runtime toggles (read directly from the environment, not config keys)
# ---------------------------------------------------------------------------
#TRADINGAGENTS_DISABLE_REDDIT=1           # turn off Reddit fetches entirely
#TRADINGAGENTS_MOMENTUM_OFFLINE=1         # skip live float fetch in the momentum scan
#TRADINGAGENTS_MOMENTUM_NO_INTRADAY=1     # skip Alpaca intraday confirmation block
